{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shot Notes Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Shot ID matching the .slog file",
      "type": "string"
    },
    "rating": {
      "description": "Star rating out of 5",
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "beanType": {
      "description": "Type or origin of coffee beans",
      "type": "string"
    },
    "doseIn": {
      "description": "Dose in grams",
      "type": "number",
      "minimum": 0
    },
    "doseOut": {
      "description": "Dose out in grams",
      "type": "number",
      "minimum": 0
    },
    "ratio": {
      "description": "Ratio (dose out / dose in)",
      "type": "number",
      "minimum": 0
    },
    "grindSetting": {
      "description": "Grind setting as string",
      "type": "string"
    },
    "balanceTaste": {
      "description": "Balance/taste selector",
      "type": "string",
      "enum": [
        "bitter",
        "balanced",
        "sour"
      ]
    },
    "notes": {
      "description": "User notes",
      "type": "string",
      "maxLength": 200
    },
    "timestamp": {
      "description": "Timestamp when notes were last updated",
      "type": "integer"
    },
    "beanId": {
      "type": "string",
      "description": "Bean library ID at brew start"
    },
    "bean": {
      "type": "object",
      "description": "Bean details captured at brew start; retained when library entries change",
      "properties": {
        "id": {
          "type": "string"
        },
        "roaster": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roastDate": {
          "type": "string",
          "format": "date"
        },
        "grindSetting": {
          "type": "number",
          "minimum": 1,
          "maximum": 16,
          "multipleOf": 0.1
        }
      }
    }
  },
  "required": [
    "id"
  ]
}
